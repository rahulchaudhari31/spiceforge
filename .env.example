# Copy this file to .env and adjust as needed.

# Demo mode: "true" runs the app fully offline against an in-browser mock API.
# When unset/blank, demo mode is enabled by default. Set to "false" to use the
# real Laravel backend.
VITE_DEMO_MODE=true

# Real backend API base URL (only used when VITE_DEMO_MODE=false).
VITE_API_URL=http://localhost:8000/api
